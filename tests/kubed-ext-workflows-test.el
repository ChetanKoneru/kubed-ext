;;; kubed-ext-workflows-test.el --- Workflow regression tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'kubed-ext-logs)
(require 'kubed-ext-actions)
(require 'kubed-ext-metrics)
(require 'kubed-ext-terminals)

(ert-deftest kubed-ext-workflows-stern-exact-re2 ()
  (let ((args (kubed-ext--stern-args
               '(:type "pods" :query "api.v1+blue" :container "side.car+" :follow t))))
    (should (equal (cadr args) "^api\\.v1\\+blue$"))
    (should (member "--container=^side\\.car\\+$" args))
    (should-not (member "pods" args))))

(ert-deftest kubed-ext-workflows-stern-workload ()
  (should (equal (cadr (kubed-ext--stern-args
                       '(:type "deployments" :query "api"))) "deployment/api")))

(ert-deftest kubed-ext-workflows-stern-options ()
  (let ((args (kubed-ext--stern-args
               '(:type "pod" :query "api" :follow nil :filter "(?i)(error|panic)"
                 :selector "app=api" :timestamps t :prefix nil))))
    (should (member "--no-follow" args))
    (should (member "--include=(?i)(error|panic)" args))
    (should (member "--selector=app=api" args))
    (should (member "--timestamps=default" args))
    (should-not (cl-some (lambda (s) (string-prefix-p "--exclude" s)) args))))

(ert-deftest kubed-ext-workflows-log-fallback-options ()
  (let (received)
    (cl-letf (((symbol-function 'kubed-logs) (lambda (&rest args) (setq received args)))
              ((symbol-function 'executable-find) (lambda (_) "/bin/stern")))
      (kubed-ext-stern-logs "pods" "p" "ctx" "ns" "c" t 12 t "2026-01-01T00:00:00Z" 3 t)
      (should (equal received '("pods" "p" "ctx" "ns" "c" t 12 t "2026-01-01T00:00:00Z" 3 t))))))

(ert-deftest kubed-ext-workflows-log-browse-and-ansi ()
  (with-temp-buffer
    (kubed-ext-log-mode)
    (let ((kubed-ext-log-retention-characters 80))
      (kubed-ext--insert-log-output (current-buffer) "first\nsecond\n")
      (goto-char 2)
      (kubed-ext--insert-log-output (current-buffer) "\e[3")
      (kubed-ext--insert-log-output (current-buffer) "1mred\e[0m\n")
      (should (= (point) 2))
      (should (or (get-text-property (- (point-max) 3) 'face)
                  (get-text-property (- (point-max) 3) 'font-lock-face)))
      (should-not (string-match-p "\e" (buffer-string)))
      (kubed-ext--insert-log-output (current-buffer) (make-string 100 ?x))
      (should (<= (buffer-size) 80)))))

(ert-deftest kubed-ext-workflows-action-rollout-order ()
  (let (argv)
    (cl-letf (((symbol-function 'kubed-ext--async-kubectl)
               (lambda (args _success &optional _error) (setq argv args))))
      (kubed-ext-rollout-history "deployments" "api" "ctx" "ns")
      (should (equal (cl-subseq argv 1 4) '("rollout" "history" "deployments/api")))
      (should (member "ctx" argv))
      (should (member "ns" argv)))))

(ert-deftest kubed-ext-workflows-mutation-confirmation ()
  (cl-letf (((symbol-function 'yes-or-no-p) (lambda (_) nil))
            ((symbol-function 'kubed-ext--async-kubectl)
             (lambda (&rest _) (ert-fail "Unconfirmed mutation launched"))))
    (kubed-ext-delete-resource "pods" "api" "ctx" "ns")
    (kubed-ext-strimzi-pause-reconciliation "kafkas.kafka.strimzi.io" "k" "ctx" "ns")))

(ert-deftest kubed-ext-workflows-forward-validation ()
  (should-error (kubed-ext-forward-port "pod" "p" 0 80 "c" "n") :type 'user-error)
  (should-error (kubed-ext-forward-port "pod" "p" 80 65536 "c" "n") :type 'user-error)
  (should (member "--address=::1" (kubed-ext--port-forward-argv "pod/p" "8080:80" "c" "n"))))

(ert-deftest kubed-ext-workflows-strimzi-validation ()
  (should-error (kubed-ext--validate-count -1 "Replicas") :type 'user-error)
  (should-error (kubed-ext--validate-count 1.5 "Replicas") :type 'user-error)
  (should (= 0 (kubed-ext--validate-count 0 "Replicas"))))

(ert-deftest kubed-ext-workflows-metric-missing ()
  (should (equal (kubed-ext--metric-quantity nil 'cpu) "n/a"))
  (should (equal (kubed-ext--metric-quantity "250m" 'cpu) "250m"))
  (should (equal (kubed-ext--metric-budget nil 'requests 'cpu) "n/a")))

(ert-deftest kubed-ext-workflows-metrics-node-command ()
  (let (calls)
    (cl-letf (((symbol-function 'pop-to-buffer) #'identity)
              ((symbol-function 'kubed-ext--async-kubectl)
               (lambda (argv _success &optional _error) (push argv calls))))
      (unwind-protect
          (progn (kubed-ext-top-nodes "test-context")
                 (should (cl-some (lambda (args) (equal (cl-subseq args 1 3) '("top" "nodes"))) calls)))
        (dolist (b (buffer-list))
          (when (string-prefix-p "*kubed-top-nodes test-context" (buffer-name b)) (kill-buffer b)))))))

(ert-deftest kubed-ext-workflows-exec-no-tty ()
  (let ((args (kubed-ext--kubectl-exec-args "p" "c" "ctx" "ns" "/bin/sh")))
    (should (member "--container" args))
    (should-not (member "-t" args))
    (should-not (member "-it" args))
    (should (equal (last args 2) '("--" "/bin/sh")))))

(ert-deftest kubed-ext-workflows-container-async ()
  (let (argv callback chosen)
    (cl-letf (((symbol-function 'kubed-ext--async-kubectl)
               (lambda (args success &optional _error) (setq argv args callback success)))
              ((symbol-function 'run-at-time)
               (lambda (_time _repeat fn &rest args) (apply fn args)))
              ((symbol-function 'active-minibuffer-window) (lambda () nil)))
      (kubed-ext--read-pod-container-async "p" "Container" "ctx" "ns"
                                            (lambda (c) (setq chosen c)) nil t)
      (should (member "ctx" argv))
      (should-not chosen)
      (funcall callback "main")
      (should (equal chosen "main")))))

(ert-deftest kubed-ext-workflows-marked-one-query ()
  (let ((items (copy-tree '((:type "pods" :name "api.1" :context "c" :namespace "n")
                            (:type "pods" :name "api+2" :context "c" :namespace "n")))) spec)
    (cl-letf (((symbol-function 'kubed-ext--action-marked-scopes) (lambda () items))
              ((symbol-function 'kubed-ext--open-log-spec) (lambda (s) (setq spec s))))
      (kubed-ext-logs-marked)
      (should (equal (cadr (kubed-ext--stern-args spec)) "^(api\\.1|api\\+2)$"))
      (setf (plist-get (cadr items) :namespace) "other")
      (should-error (kubed-ext-logs-marked) :type 'user-error))))

(ert-deftest kubed-ext-workflows-log-late-output-and-kill ()
  (let ((b (generate-new-buffer " *workflow stream*")) launches)
    (unwind-protect
        (cl-letf (((symbol-function 'make-process)
                   (lambda (&rest args)
                     (let ((p (make-symbol "fake-process")))
                       (push (list p (plist-get args :filter) (plist-get args :sentinel)) launches) p))))
          (with-current-buffer b
            (kubed-ext-log-mode)
            (setq kubed-ext--log-spec '(:type "pod" :query "p" :follow t)
                  kubed-ext--log-environment (kubed-ext--capture-environment))
            (kubed-ext-restart-logs)
            (let ((old (car launches)))
              (kubed-ext-restart-logs)
              (funcall (nth 1 old) (car old) "STALE")
              (should-not (string-match-p "STALE" (buffer-string)))
              (funcall (nth 1 (car launches)) (caar launches) "fresh")
              (should (equal (buffer-string) "fresh")))))
      (when (buffer-live-p b) (kill-buffer b)))))

(ert-deftest kubed-ext-workflows-stale-metrics ()
  (with-temp-buffer
    (kubed-ext-top-mode)
    (setq kubed-ext--top-scope '(:type "pods" :namespace "n"))
    (let (callback)
      (cl-letf (((symbol-function 'kubed-ext--async-kubectl)
                 (lambda (_argv success &optional _error) (setq callback success))))
        (kubed-ext--top-request (current-buffer) 0 '("fake") 'kubed-ext--top-objects #'kubed-ext--metric-items)
        (setq kubed-ext--top-generation 1)
        (funcall callback "{\"items\":[{\"metadata\":{\"name\":\"old\"}}]}")
        (should-not kubed-ext--top-objects)))))

(ert-deftest kubed-ext-workflows-metric-budget-incomplete ()
  (should (equal (kubed-ext--metric-budget
                  '(((resources . ((requests . ((cpu . "100m"))))))
                    ((resources . ((requests . ((memory . "1Mi"))))))) 'requests 'cpu) "n/a"))
  (should (equal (kubed-ext--metric-budget
                  '(((resources . ((requests . ((cpu . "100m"))))))
                    ((resources . ((requests . ((cpu . "200m"))))))) 'requests 'cpu) "300m")))

(ert-deftest kubed-ext-workflows-forward-state ()
  (let ((entry (list :state 'starting :buffer nil :message "")))
    (kubed-ext--forward-update entry "Forwarding from [::1]:8080 -> 80\n")
    (should (eq (plist-get entry :state) 'ready))
    (kubed-ext--forward-update entry "error: connection failed\n")
    (should (eq (plist-get entry :state) 'error))
    (kubed-ext--forward-update entry "exited\n" t)
    (should (eq (plist-get entry :state) 'error))))

(ert-deftest kubed-ext-workflows-origin-refresh ()
  (let ((origin (generate-new-buffer " *workflow origin*")) refreshed
        (scope '(:type "pods" :name "p" :context "c" :namespace "n")))
    (unwind-protect
        (with-current-buffer origin
          (kubed-ext-resources-mode)
          (let ((environment (kubed-ext--capture-environment)))
            (setq kubed-ext--view-scope (append scope (list :environment environment)))
            (cl-letf (((symbol-function 'kubed-ext-refresh-resources)
                       (lambda () (setq refreshed (current-buffer)))))
              (kubed-ext--action-refresh-origin origin scope environment)
              (should (eq refreshed origin))
              (setq refreshed nil)
              (kubed-ext--action-refresh-origin origin scope '(:eenv "other"))
              (should-not refreshed))))
      (kill-buffer origin))))

(ert-deftest kubed-ext-workflows-real-finite-log-stream ()
  (let ((b (generate-new-buffer " *workflow real stream*")) p)
    (unwind-protect
        (with-current-buffer b
          (kubed-ext-log-mode)
          (setq p (make-process :name "workflow-fixture" :buffer nil :noquery t
                                :command '("/bin/sh" "-c" "printf '\033[31mred\033[0m\\n'")
                                :filter (lambda (_p text) (kubed-ext--insert-log-output b text))))
          (while (process-live-p p) (accept-process-output p 0.05))
          (accept-process-output p 0.05)
          (should (equal (buffer-substring-no-properties (point-min) (point-max)) "red\n"))
          (should (or (get-text-property 1 'font-lock-face) (get-text-property 1 'face))))
      (when (process-live-p p) (delete-process p))
      (when (buffer-live-p b) (kill-buffer b)))))

(ert-deftest kubed-ext-workflows-selected-logs-ignore-view-selector ()
  (let (spec)
    (cl-letf (((symbol-function 'kubed-ext--open-log-spec) (lambda (s) (setq spec s))))
      (kubed-ext--logs-scope '(:type "pods" :name "exact" :selector "app=broad"))
      (should (equal (cadr (kubed-ext--stern-args spec)) "^exact$"))
      (should-not (member "--selector=app=broad" (kubed-ext--stern-args spec))))))

(ert-deftest kubed-ext-workflows-real-owned-log-lifecycle ()
  (let ((b (generate-new-buffer " *workflow owned log*")) (kubed-ext--log-buffers nil) old current)
    (unwind-protect
        (cl-letf (((symbol-function 'kubed-ext--stern-args)
                   (lambda (_) '("/bin/sh" "-c" "printf 'ready\\n'; exec sleep 5"))))
          (with-current-buffer b
            (kubed-ext-log-mode)
            (setq kubed-ext--log-spec '(:type "pod" :query "fixture")
                  kubed-ext--log-environment (kubed-ext--capture-environment))
            (push b kubed-ext--log-buffers)
            (setq old (kubed-ext-restart-logs))
            (accept-process-output old 0.1)
            (setq current (kubed-ext-restart-logs))
            (should-not (process-live-p old))
            (should (process-live-p current))
            (kill-buffer b)
            (should-not (process-live-p current))
            (should-not kubed-ext--log-buffers)))
      (dolist (p (list old current)) (when (process-live-p p) (delete-process p)))
      (when (buffer-live-p b) (kill-buffer b)))))

(ert-deftest kubed-ext-workflows-real-port-forward-lifecycle ()
  (let ((kubed-ext--port-forwards nil) (kubed-ext--action-prompt-timers nil) p buffer)
    (unwind-protect
        (cl-letf (((symbol-function 'kubed-ext--port-forward-argv)
                   (lambda (&rest _) '("/bin/sh" "-c" "printf 'Forwarding from [::1]:8080 -> 80\\n'; exec sleep 5"))))
          (setq p (kubed-ext-forward-port "pod" "fixture" 8080 80 "ctx" "ns")
                buffer (plist-get (car kubed-ext--port-forwards) :buffer))
          (accept-process-output p 0.1)
          (should (eq (plist-get (car kubed-ext--port-forwards) :state) 'ready))
          (kill-buffer buffer)
          (should-not (process-live-p p))
          (should-not kubed-ext--port-forwards)
          (kubed-ext-port-forwards-stop-all)
          (should-not kubed-ext--port-forwards))
      (when (process-live-p p) (delete-process p))
      (when (buffer-live-p buffer) (kill-buffer buffer)))))

(ert-deftest kubed-ext-workflows-forward-split-readiness ()
  (let ((entry (list :state 'starting :buffer nil :message "")))
    (kubed-ext--forward-update entry "Forwarding fr")
    (kubed-ext--forward-update entry "om [::1]:8080 -> 80\n")
    (should (eq (plist-get entry :state) 'ready))))

(ert-deftest kubed-ext-workflows-pod-effective-budget ()
  (let ((pod '((spec . ((containers . (((resources . ((requests . ((cpu . "100m"))))))))
                       (initContainers . (((resources . ((requests . ((cpu . "250m"))))))))
                       (overhead . ((cpu . "10m"))))))))
    (should (= (kubed-ext--pod-budget-value pod 'requests 'cpu) 260))))

